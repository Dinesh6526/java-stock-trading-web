# Copy this file to .env and edit the values.
PORT=3000

# MySQL connection (the database is created automatically if it does not exist)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tradesim

# Any long random text. Change this before putting the site online.
JWT_SECRET=change-me-to-a-long-random-string

# Virtual money given to every new account (Rs.)
STARTING_BALANCE=100000

# How often the simulated prices move (milliseconds)
TICK_MS=5000
